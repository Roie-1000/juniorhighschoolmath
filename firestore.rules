rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function cls(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data;
    }
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.tch == request.auth.uid);
      // 學生本人：只能加入存在、而且沒有把自己踢出的班級
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (request.resource.data.cls == ""
            || (exists(/databases/$(database)/documents/classes/$(request.resource.data.cls))
                && request.resource.data.tch == cls(request.resource.data.cls).teacher
                && !(uid in cls(request.resource.data.cls).get('kicked', {}))));
      // 老師：只能把自己班上的學生移出班級（清空 cls、tch）
      allow update: if request.auth != null && resource.data.tch == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cls', 'tch'])
        && request.resource.data.cls == "" && request.resource.data.tch == "";
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /classes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacher == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacher == request.auth.uid;
    }
  }
}
