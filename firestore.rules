rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function cls(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data;
    }
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.tch == request.auth.uid);
      // 學生本人：只能加入存在、而且沒有把自己踢出的班級
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (request.resource.data.cls == ""
            || (exists(/databases/$(database)/documents/classes/$(request.resource.data.cls))
                && request.resource.data.tch == cls(request.resource.data.cls).teacher
                && !(uid in cls(request.resource.data.cls).get('kicked', {}))));
      // 老師：只能把自己班上的學生移出班級（清空 cls、tch）
      allow update: if request.auth != null && resource.data.tch == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cls', 'tch'])
        && request.resource.data.cls == "" && request.resource.data.tch == "";
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function isTeacher(code) {
      return request.auth != null && cls(code).teacher == request.auth.uid;
    }
    function isMember(code) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cls == code;
    }
    function dmOk(code, sid) {
      return isTeacher(code) || (request.auth != null && request.auth.uid == sid && isMember(code));
    }
    match /classes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacher == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacher == request.auth.uid;
      // 排行榜：同班同學和老師可讀；學生只能寫自己那一筆；老師可刪除
      match /board/{uid} {
        allow read: if isTeacher(code) || isMember(code);
        allow create, update: if request.auth != null && request.auth.uid == uid && isMember(code);
        allow delete: if isTeacher(code) || (request.auth != null && request.auth.uid == uid);
      }
      // 公告：同班同學和老師可讀；只有老師能發布和刪除
      match /posts/{pid} {
        allow read: if isTeacher(code) || isMember(code);
        allow create, update, delete: if isTeacher(code);
      }
      // 聊天區：同班同學和老師可讀、可發言；自己的訊息或老師可以刪除
      match /chat/{mid} {
        allow read: if isTeacher(code) || isMember(code);
        allow create: if (isTeacher(code) || isMember(code))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time
          && (request.resource.data.role == "s" || (request.resource.data.role == "t" && isTeacher(code)));
        allow delete: if isTeacher(code)
          || (request.auth != null && resource.data.uid == request.auth.uid);
      }
      // 私訊：只有老師和那位學生本人可讀、可發言
      match /dm/{sid} {
        allow read, create, update: if dmOk(code, sid);
        allow delete: if isTeacher(code);
        match /msgs/{mid} {
          allow read: if dmOk(code, sid);
          allow create: if dmOk(code, sid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 300
            && request.resource.data.at == request.time
            && (request.resource.data.role == "s" || (request.resource.data.role == "t" && isTeacher(code)));
          allow delete: if isTeacher(code)
            || (request.auth != null && resource.data.uid == request.auth.uid);
        }
      }
    }
  }
}
